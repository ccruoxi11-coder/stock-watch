# 企业微信群机器人 Webhook 完整 URL（不填则只弹窗/写日志，不推送）
WECOM_WEBHOOK=

# 主力净流入告警阈值（元），0 关闭。例如 50000000 = 5000万
FUND_FLOW_THRESHOLD=50000000

# 涨跌幅告警阈值（百分比绝对值）。默认 3 表示 |涨跌幅| > 3%
PCT_THRESHOLD=3.0

# 主力净流入占成交额比例告警阈值（%），0 关闭
FUND_RATIO_THRESHOLD=10.0

# 主力连续同向天数告警阈值（天），0 关闭
FUND_STREAK_DAYS=3

# 盘中急变：近 N 分钟主力净流入/流出金额阈值（元），0 关闭。3000万 = 0.3亿
FUND_BURST_THRESHOLD=30000000

# 盘中急变观察窗口（分钟）
FUND_BURST_WINDOW=5

# 自动刷新间隔（秒）
REFRESH_SECONDS=60
